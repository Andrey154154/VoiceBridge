#!/usr/bin/env bash
set -euo pipefail
PYTHON=/opt/voice-bridge/runtime/bin/python
[[ -x "$PYTHON" ]] || { echo 'Install runtime: sudo /opt/voice-bridge/bootstrap-runtime.sh' >&2; exit 1; }
export PYTHONPATH="/opt/voice-bridge/app/src"
export PYTHONNOUSERSITE=1
exec "$PYTHON" -m voice_bridge.cli "$@"
